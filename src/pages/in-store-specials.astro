---
import Base from '@/layouts/Base.astro';
import StoreStrip from '@/components/StoreStrip.astro';
import SpecialCard from '@/components/SpecialCard.astro';
import LeadForm from '@/components/LeadForm.astro';
import PromoBanner from '@/components/PromoBanner.astro';
import Icons from '@/components/Icons.astro';
import { location, specials, specialsIntro, activeBanners, hoursRows, displayPhone, telHref, fullAddress, siteUrl } from '@/lib/site';
const c = location.city;
const title = `In-Store Specials and Walk-In Deals | ${location.name}`;
const description = `Showroom-only hot tub, swim spa and sauna offers at ${location.name}, ${fullAddress}. Floor model clearance, bundles and flash pricing you can only get by visiting. Open 7 days.`;
const schema = [
  { '@context': 'https://schema.org', '@type': 'OfferCatalog', name: `In-store specials at ${location.name}`, url: siteUrl + '/in-store-specials/',
    itemListElement: specials.map((s) => ({ '@type': 'Offer', name: s.title, description: s.summary, availability: 'https://schema.org/InStoreOnly', availableAtOrFrom: { '@id': `${siteUrl}/#store` }, ...(s.endsOn ? { validThrough: s.endsOn } : {}) })) },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl + '/' }, { '@type': 'ListItem', position: 2, name: 'In-Store Specials', item: siteUrl + '/in-store-specials/' }] }
];
---
<Base title={title} description={description} schema={schema}>
  <section class="hero" style="padding:44px 0 40px">
    <div class="wrap" style="grid-template-columns:1fr">
      <div style="max-width:760px">
        <div class="eyebrow" style="color:#ffd9cc">Showroom only · {c}</div>
        <h1>In-Store Specials at the {c} Showroom</h1>
        <p class="lead">Claim an offer below and we create a personal Red Tag voucher with your name, a code and a countdown. Show it on your phone at the {c} showroom. You will not find these prices on wellnessshop.ca or anywhere else online.</p>
        <div class="cta-row">
          <a class="btn btn-primary" href={location.directionsUrl} target="_blank" rel="noopener" data-loc="specials-hero"><Icons name="pin" /> Get directions</a>
          <a class="btn btn-light" href={telHref} data-loc="specials-hero"><Icons name="phone" /> Call ahead {displayPhone}</a>
        </div>
        <p class="fine" style="margin-top:14px">{fullAddress} · {hoursRows().map((r) => `${r.label} ${r.value}`).join(' · ')}</p>
      </div>
    </div>
  </section>
  <StoreStrip />

  <section class="section redtag-feature" id="red-tag-clearance">
    <div class="wrap two-col" style="align-items:center">
      <div>
        <div class="eyebrow" style="color:#e5352b">Jacuzzi exclusive Red Tag · Inventory clearance</div>
        <h2>Why Would We Take 20% Off a Brand New Jacuzzi?</h2>
        <p class="lead">Three honest reasons, and none of them are about the tubs.</p>
        <ol class="reasons">
          <li><b>New model year.</b> The 2027 Jacuzzi lineup needs the floor space, so every remaining 2026 unit has to move.</li>
          <li><b>Stock on hand.</b> There are 65 new 2026 Jacuzzi hot tubs across our Ontario showrooms, already here and already paid for.</li>
          <li><b>A two month window.</b> We would rather deliver them to backyards in {c} before the snow than store them over winter.</li>
        </ol>
        <p>So we replaced both old Red Tag offers, $1,000 off and free electrical, with one bigger one: 20% off every new 2026 Jacuzzi in stock. Same model, same full Jacuzzi warranty, delivery and setup included. The only thing on clearance is the price.</p>
        <div class="cta-row">
          <a class="btn btn-primary" href="#jacuzzi-red-tag-20"><Icons name="tag" /> Claim your Red Tag price</a>
          <a class="btn btn-navy" href="/hot-tubs/?brand=Jacuzzi">See the 2026 Jacuzzi models</a>
        </div>
        <p class="fine">Applies to in-stock new 2026 Jacuzzi hot tub models while quantities last. Not combinable with the $1,000 off or free electrical offers. Prices and availability vary by showroom; see the {c} team for details.</p>
      </div>
      <a class="redtag-visual" href="#jacuzzi-red-tag-20" aria-label="Claim the 20% off Red Tag price">
        <img src="/images/promo/redtag-couple.webp" alt="Couple relaxing in a new Jacuzzi hot tub with a 20% off Red Tag" width="1400" height="1757" loading="lazy" />
      </a>
    </div>
    <div class="wrap redtag-strip">
      <a href="/hot-tubs/?brand=Jacuzzi" aria-label="See which 2026 Jacuzzi models are still available"><img src="/images/promo/redtag-two-months.webp" alt="Two months to clear 65 Jacuzzi hot tubs" width="1000" height="1255" loading="lazy" /></a>
      <a href="#jacuzzi-red-tag-20" aria-label="Claim the 20% off Red Tag price"><img src="/images/promo/redtag-one-bigger-offer.webp" alt="We replaced the $1,000 off and free electrical offers with 20% off every new 2026 model in stock" width="1000" height="1255" loading="lazy" /></a>
      <a href="/showroom/" aria-label="Book a showroom visit"><img src="/images/promo/redtag-showroom-floor.webp" alt="Showroom floor with a Red Tag on every Jacuzzi hot tub" width="1200" height="1200" loading="lazy" /></a>
    </div>
  </section>

  <section class="section soft">
    <div class="wrap">
      <div class="eyebrow">Claim at the counter</div>
      <h2 style="margin-bottom:6px">Showroom Offers in {c}</h2>
      <p class="lead" style="margin-top:0">{specialsIntro}</p>
      {specials.length === 0 ? (
        <p class="lead">New showroom offers are being loaded. Call {displayPhone} and ask what is on the floor this week.</p>
      ) : (
        <div class="offers" style="padding-top:10px">{specials.map((s) => <SpecialCard s={s} />)}</div>
      )}
    </div>
  </section>

  <section class="section soft">
    <div class="wrap two-col">
      <div>
        <div class="eyebrow">How it works</div>
        <h2>Three Steps to the Showroom Deal</h2>
        <div class="steps" style="margin-top:20px">
          <div><h3>Claim your offer</h3><p style="color:var(--muted)">Tap Claim, give us your name and mobile, and your Red Tag voucher appears instantly with a code and a 7 day countdown.</p></div>
          <div><h3>We hold it for you</h3><p style="color:var(--muted)">The {c} team gets your voucher the moment you claim it, so the floor model or wet test is set aside under your name.</p></div>
          <div><h3>Show it at the counter</h3><p style="color:var(--muted)">Open the voucher on your phone or print it. The offer is applied to your showroom quote.</p></div>
        </div>
        {activeBanners.length > 0 && (
          <div style="margin-top:34px">
            <h2 style="font-size:1.4rem">Also On Right Now</h2>
            <p style="color:var(--muted)">These run on every model and stack with the showroom offers above.</p>
            <div class="promos" style="grid-template-columns:1fr">{activeBanners.map((b) => <PromoBanner b={b} />)}</div>
          </div>
        )}
      </div>
      <div>
        <LeadForm source="specials" title="Hold a special for me" sub={`Tell us which offer you want and when you plan to visit and the ${c} team will confirm availability and set it aside.`} button="Hold it for me" />
      </div>
    </div>
  </section>

  <section class="section navy">
    <div class="wrap two-col">
      <div>
        <h2>Visit {location.name}</h2>
        <p style="color:#cfe0ea">{location.whyVisit}</p>
        <p style="color:#cfe0ea">{fullAddress}</p>
        <table class="hours" style="color:#fff;max-width:420px">{hoursRows().map((r) => <tr><td style="border-color:rgba(255,255,255,.15)">{r.label}</td><td style="border-color:rgba(255,255,255,.15)">{r.value}</td></tr>)}</table>
        <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:18px">
          <a class="btn btn-primary" href={location.directionsUrl} target="_blank" rel="noopener" data-loc="specials-footer">Get directions</a>
          <a class="btn btn-light" href={telHref} data-loc="specials-footer">Call {displayPhone}</a>
        </div>
      </div>
      <iframe class="map" loading="lazy" title={`Map to ${location.name}`} referrerpolicy="no-referrer-when-downgrade" src={`https://www.google.com/maps?q=${encodeURIComponent(location.name + ' ' + location.street + ' ' + location.locality + ' ON')}&output=embed`}></iframe>
    </div>
  </section>
</Base>
