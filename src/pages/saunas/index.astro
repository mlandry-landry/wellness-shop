---
import CategoryPage from '@/components/CategoryPage.astro';
import { location } from '@/lib/site';
const c = location.city;
---
<CategoryPage cat="sauna" filterKey="brand"
  title={`Infrared and Outdoor Saunas in ${c} | Clearlight and Serenity | ${location.name}`}
  description={`Clearlight Sanctuary full-spectrum infrared saunas from $4,599 and Canadian-made Serenity cedar outdoor saunas at our ${location.locality} showroom. See them in person, financing OAC.`}
  h1={`Infrared and Outdoor Saunas in ${c}`}
  intro={`Two very different ways to sweat. Clearlight infrared cabins go inside the house and plug into a standard outlet. Serenity outdoor cedar saunas go in the backyard and run hot, up to 194 degrees, with an electric or wood-burning heater.`}
  body={[
    `Infrared saunas heat you, not the air, so they run at 120 to 150 degrees and you can stay in for 30 to 45 minutes. Clearlight Sanctuary cabins use True Wave full-spectrum heaters, low EMF construction, and come with a lifetime warranty on the heaters and cabin. They assemble in a couple of hours in a basement, spare room or garage and run on a regular household circuit for the 1 and 2 person models.`,
    `Serenity outdoor saunas are built in Canada from Western red cedar in knotty or clear grades. They are traditional hot saunas, so you add a HUUM or Karhu heater, throw water on the stones and get the full Nordic experience. They pair beautifully with a hot tub or cold plunge for a contrast routine.`,
    `Both are set up at the ${c} showroom so you can step inside, feel the heat and see the build quality.`
  ]}
  faq={[
    { q: 'Infrared or traditional sauna?', a: 'Infrared is gentler, quicker to heat, cheaper to run and fits indoors. Traditional is hotter, more humid with steam, and is an outdoor centrepiece. Many customers who try both in the showroom end up wanting the traditional feel outside and infrared for daily recovery.' },
    { q: 'What electrical does a sauna need?', a: 'Clearlight Sanctuary 1 and 2 run on a standard 15 or 20 amp 120V circuit. Larger cabins and all Serenity electric heaters need a dedicated 240V circuit. Wood-burning heaters need no electrical at all.' },
    { q: 'Can a sauna be financed?', a: 'Yes. Serenity outdoor saunas are shown with bi-weekly payments and Clearlight cabins can be financed OAC as well. Ask in the showroom or on the form.' }
  ]} />
