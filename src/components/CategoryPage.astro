---
import Base from '@/layouts/Base.astro';
import StoreStrip from '@/components/StoreStrip.astro';
import ProductCard from '@/components/ProductCard.astro';
import LeadForm from '@/components/LeadForm.astro';
import { copy, linkModels, location, byCategory, categories, money, biweekly, financeNote, telHref, displayPhone, siteUrl, productPath } from '@/lib/site';
interface Props { cat: keyof typeof categories; title: string; description: string; h1: string; intro: string; body: string[]; faq: { q: string; a: string }[]; filterKey?: 'brand' | 'series'; }
const props = Astro.props;
const local = (copy.categories as any)[props.cat];
// Store-written copy wins over the shared defaults so each site reads differently.
const { cat, title, description, h1, filterKey = 'brand' } = props;
const intro = local?.intro || props.intro;
const body: string[] = local?.body || props.body;
const faq: { q: string; a: string }[] = local?.faq || props.faq;
const items = byCategory(cat);
const priced = items.filter((p) => p.sale || p.msrp);
const min = priced.length ? Math.min(...priced.map((p) => p.sale || p.msrp!)) : null;
const filters = [...new Set(items.map((p) => (p as any)[filterKey]).filter(Boolean))];
const schema = [
  { '@context': 'https://schema.org', '@type': 'ItemList', name: h1, itemListElement: items.map((p, i) => ({ '@type': 'ListItem', position: i + 1, url: siteUrl + productPath(p), name: `${p.brand} ${p.model}` })) },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl + '/' }, { '@type': 'ListItem', position: 2, name: categories[cat].label, item: siteUrl + categories[cat].path }] }
];
---
<Base title={title} description={description} schema={schema}>
  <StoreStrip />
  <section class="section" style="padding-top:28px">
    <div class="wrap">
      <nav class="breadcrumbs"><a href="/">Home</a> / {categories[cat].label}</nav>
      <h1 style="margin-top:8px">{h1}</h1>
      <p class="lead">{intro}</p>
      {min && <p class="callout" style="max-width:720px"><strong>From {money(min)}</strong>{priced.some((p) => p.biweekly) && <> or from {biweekly(Math.min(...priced.filter((p) => p.biweekly).map((p) => p.biweekly!)))} at 0% for 12 months OAC*.</>} Every price below is the current sale price at the {location.city} showroom. Floor model and in-store offers are on the <a href="/in-store-specials/">specials page</a>.</p>}
      <p style="margin:-6px 0 18px"><a href={`/find-my-hot-tub/?type=${cat}`} data-track="quiz_start" data-loc="category" style="font-weight:600">Not sure which one? Take the 60 second finder &rarr;</a></p>
      {filters.length > 1 && (
        <div class="filters" id="filters" role="group" aria-label={`Filter by ${filterKey}`}>
          <button aria-pressed="true" data-f="">All ({items.length})</button>
          {filters.map((f) => <button aria-pressed="false" data-f={f}>{f} ({items.filter((p) => (p as any)[filterKey] === f).length})</button>)}
        </div>
      )}
      <div class="grid cols-4" id="grid">{items.map((p) => <ProductCard p={p} />)}</div>
      <p class="fine" style="color:var(--muted);font-size:.8rem;margin-top:18px">*{financeNote} Prices in CAD at the {location.city} showroom and subject to change.</p>
    </div>
  </section>
  <section class="section soft">
    <div class="wrap two-col">
      <div>
        {body.map((para) => <p set:html={linkModels(para)} />)}
        <div class="faq" style="margin-top:28px">
          <h2 style="font-size:1.5rem">{categories[cat].label} Questions</h2>
          {faq.map((f) => <details><summary>{f.q}</summary><p set:html={linkModels(f.a)} /></details>)}
        </div>
      </div>
      <div>
        <LeadForm source={`category:${cat}`} title={`${categories[cat].label} pricing and availability`} sub={`Tell us what you have in mind and the ${location.city} team will get back to you with showroom pricing and what is on the floor right now.`} />
        <p style="margin-top:14px;text-align:center"><a class="btn btn-outline" href={telHref}>Call {displayPhone}</a></p>
      </div>
    </div>
  </section>
  <script define:vars={{ filterKey }}>
    const wrap = document.getElementById('filters');
    if (wrap) wrap.addEventListener('click', (e) => {
      const b = e.target.closest('button'); if (!b) return;
      wrap.querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      const f = b.dataset.f;
      document.querySelectorAll('#grid .card').forEach((c) => { c.style.display = !f || c.dataset[filterKey] === f ? '' : 'none'; });
    });
    const q = new URLSearchParams(location.search).get(filterKey);
    if (q && wrap) { const b = [...wrap.querySelectorAll('button')].find((x) => x.dataset.f.toLowerCase() === q.toLowerCase()); b && b.click(); }
  </script>
</Base>
