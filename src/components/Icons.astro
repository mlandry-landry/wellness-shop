const fill = ['phone', 'pin', 'tag', 'star'].includes(name);
---
<svg class={cls} viewBox="0 0 24 24" aria-hidden="true" fill={fill ? 'currentColor' : 'none'} stroke={fill ? 'none' : 'currentColor'} stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d={paths[name]} /></svg>
