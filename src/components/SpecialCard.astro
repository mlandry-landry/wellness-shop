---
import Icons from './Icons.astro';
import { location, telHref, displayPhone, type Special } from '@/lib/site';
const { s } = Astro.props as { s: Special & Record<string, any> };
const ends = s.endsOn ? new Date(s.endsOn + 'T23:59:00-04:00').toLocaleDateString('en-CA', { month: 'long', day: 'numeric' }) : null;
---
<article class="offer" id={s.id}>
  <header class="offer-head">
    <div class="offer-badge">{s.badge || 'Showroom offer'}</div>
    <div class="offer-value">{s.value}</div>
    {s.valueSub && <div class="offer-sub">{s.valueSub}</div>}
  </header>
  <div class="offer-body">
    <h3>{s.title}</h3>
    <p class="offer-summary">{s.summary}</p>
    {s.details?.length > 0 && (
      <ul class="offer-list">{s.details.slice(0, 3).map((d: string) => <li><Icons name="check" />{d}</li>)}</ul>
    )}
  </div>
  <footer class="offer-foot">
    <div class="offer-claim">
      {s.claimCode ? (
        <><span class="offer-claim-label">Voucher code</span><span class="code">{s.claimCode}</span></>
      ) : (
        <><span class="offer-claim-label">Voucher on claim</span><span class="offer-claim-note">We text you a personal Red Tag voucher</span></>
      )}
      {ends && <span class="offer-ends">Ends {ends}</span>}
    </div>
    <button class="btn btn-primary offer-cta" type="button" data-claim={s.id}><Icons name="tag" /> Claim this offer</button>
    <div class="offer-links">
      <a href={location.directionsUrl} target="_blank" rel="noopener" data-loc={`special:${s.id}`}><Icons name="pin" /> Directions</a>
      <a href={telHref} data-loc={`special:${s.id}`}><Icons name="phone" /> {displayPhone}</a>
    </div>
  </footer>
</article>
