---
// Original red price-tag motif used across the sites (hero pill, offer cards, voucher).
interface Props { line1: string; line2?: string; size?: number; class?: string }
const { line1, line2, size = 140, class: cls = '' } = Astro.props;
---
<svg class={`redtag ${cls}`} viewBox="0 0 200 110" width={size} height={size * 0.55} role="img" aria-label={`${line1} ${line2 || ''}`}>
  <defs><linearGradient id="rt" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#e5352b"/><stop offset="1" stop-color="#b3130d"/></linearGradient></defs>
  <path d="M38 8h140a10 10 0 0 1 10 10v74a10 10 0 0 1-10 10H38L6 62a10 10 0 0 1 0-14z" fill="url(#rt)"/>
  <path d="M38 8h140a10 10 0 0 1 10 10v74a10 10 0 0 1-10 10H38L6 62a10 10 0 0 1 0-14z" fill="none" stroke="#fff" stroke-opacity=".35" stroke-width="2" stroke-dasharray="4 4" transform="translate(0 0) scale(.96) translate(4 2)"/>
  <circle cx="26" cy="55" r="7" fill="#fff"/><circle cx="26" cy="55" r="4" fill="#8f0e09"/>
  <text x="112" y={line2 ? 52 : 62} text-anchor="middle" font-family="Outfit, Inter, system-ui, sans-serif" font-weight="700" font-size={line1.length > 12 ? 19 : 26} fill="#fff" {...(line1.length > 10 ? { textLength: 136, lengthAdjust: 'spacingAndGlyphs' } : {})}>{line1}</text>
  {line2 && <text x="112" y="78" text-anchor="middle" font-family="Inter, system-ui, sans-serif" font-weight="600" font-size="13" fill="#ffe1dd" letter-spacing=".5">{line2}</text>}
</svg>
